# Self-hosted application and local model inference. No managed sandbox required.
STELLIS_DEPLOYMENT=self-hosted
STELLIS_RUNTIME_PROFILE=local
STELLIS_AGENT_BACKEND=direct
STELLIS_DATA_DIR=/var/lib/stellis/local
STELLIS_ACCOUNT_ID=1
# ollama or openai (vLLM / llama.cpp); the URL stays on the application host.
STELLIS_LOCAL_INFERENCE_PROVIDER=ollama
STELLIS_LOCAL_INFERENCE_URL=http://127.0.0.1:11434/v1
STELLIS_LOCAL_INFERENCE_MODEL=nemotron-3-nano:latest
# Optional private local server credential, never a cloud provider key.
STELLIS_LOCAL_INFERENCE_TOKEN=
# Local recognition; choose CPU Kitten or a separately installed Chatterbox service.
STELLIS_TTS_BACKEND=local
STELLIS_CHATTERBOX_LOCAL_URL=http://127.0.0.1:8004
STELLIS_CHATTERBOX_LOCAL_TOKEN=
STELLIS_CHATTERBOX_VOICE=Elena.wav
# Optional: explicitly choose STELLIS_AGENT_BACKEND=nemoclaw for an installed sandbox.
# STELLIS_NEMOCLAW_COMMAND=nemoclaw
# STELLIS_NEMOCLAW_SANDBOX=stellis-local
# NEMOCLAW_GATEWAY_PORT=8990
