# Cloud application and Token Factory inference. App-owned tools run directly.
# Optional managed gateway is a separate, explicit choice, never assumed live.
STELLIS_DEPLOYMENT=cloud
STELLIS_RUNTIME_PROFILE=cloud
STELLIS_AGENT_BACKEND=direct
STELLIS_DATA_DIR=/var/lib/stellis/cloud
STELLIS_ACCOUNT_ID=1
NEBIUS_API_KEY=
STELLIS_TTS_BACKEND=nebius
STELLIS_CHATTERBOX_NEBIUS_URL=
STELLIS_CHATTERBOX_NEBIUS_TOKEN=
STELLIS_CHATTERBOX_VOICE=Emily.wav
# Optional: change STELLIS_AGENT_BACKEND to gateway after provisioning/testing it.
# STELLIS_AGENT_GATEWAY_ACCOUNT_ID=1
# STELLIS_AGENT_GATEWAY_URL=https://your-authenticated-agent-gateway
# STELLIS_AGENT_GATEWAY_TOKEN=
# STELLIS_AGENT_MODEL_PROVIDER=nebius
